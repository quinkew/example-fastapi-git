[Unit]
Description=demo fastapi app
After=network.target

[Service]
User=fastapi
Group=fastapi
WorkingDirectory=/home/fastapi/app/src
Environment="PATH=/home/fastapi/app/bin"
EnvironmentFile=/home/fastapi/.env
ExecStart=/home/fastapi/app/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 server.main:app

[Install]
WantedBy=multi-user.target
